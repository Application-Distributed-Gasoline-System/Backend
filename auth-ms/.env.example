# Este archivo .env es para probarlo de manera local, ya que ahora
# estamos poniendo directamente enviroments en nuestro docker, asi que no tiene mucha importancia
# los envs de aqui

PORT=5002
HOST=0.0.0.0
JWT_SECRET=genera-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_DAYS=30
RESET_TOKEN_EXPIRES_HOURS=1

# Cadena de conexión de Neon (PostgreSQL)
DATABASE_URL='postgresql://USUARIO:CONTRASENA@HOST:5432/authdb?sslmode=require'

# Envío de correos
SMTP_USER="usuario-smtp@ejemplo.com"
SMTP_PASS=contrasena-smtp
SENDER_EMAIL="remitente@ejemplo.com"

NODE_ENV=production

# NATS
NATS_SERVERS="nats://localhost:4222"