# Variables que leen docker-compose.yml y docker-compose.prod.yml.
# Copia este archivo como .env (ya está en .gitignore) y rellénalo.
# Nunca subas el .env ni escribas credenciales en los archivos de Compose.

# Bases de datos PostgreSQL, una por microservicio
AUTH_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/authdb?sslmode=require
DRIVERS_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/driversdb?sslmode=require
VEHICLES_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/vehiclesdb?sslmode=require
# Réplica de solo lectura de vehicles; puede ser la misma URL si no hay réplica
VEHICLES_READ_REPLICA_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/vehiclesdb?sslmode=require
ROUTES_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/routesdb?sslmode=require

# MongoDB del microservicio de combustible (Prisma exige un replica set)
FUEL_DATABASE_URL=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/fueldb

# Autenticación. Genera la clave con: openssl rand -hex 32
JWT_SECRET=

# Correo (Brevo u otro SMTP)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Contraseña del usuario admin de Grafana (solo docker-compose.yml)
GRAFANA_ADMIN_PASSWORD=
